---
import { REPO_URL } from "../lib/paths.ts";

const links = [
  { href: "/runbooks/", label: "Runbooks" },
  { href: "/systems/", label: "Systems" },
  { href: "/about/", label: "About" },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== "/" && path.startsWith(href));
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="/" aria-label="Debug Runbooks — home">
      <svg class="wordmark__glyph" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path d="M1 14h3l2-8 3 12 3-9 2 5h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"></path>
      </svg>
      <span>Debug Runbooks</span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="ext" href={REPO_URL} rel="noopener">GitHub</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-block-end: var(--border-thin) solid var(--border-default);
    background: var(--surface-primary);
    padding-block-start: env(safe-area-inset-top);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--space-5);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: 3.25rem;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
  }

  .wordmark__glyph {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    color: var(--brand-primary);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    margin: 0 calc(var(--space-3) * -1);
    padding: 0;
    list-style: none;
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-min);
    padding-inline: var(--space-3);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    text-decoration: none;
    border-block-end: var(--border-thick) solid transparent;
  }

  .nav a:hover {
    color: var(--text-primary);
  }

  .nav a[aria-current="page"] {
    color: var(--text-primary);
    border-block-end-color: var(--brand-primary);
  }

  @media (max-width: 22rem) {
    .nav a {
      padding-inline: var(--space-2);
    }
  }
</style>
