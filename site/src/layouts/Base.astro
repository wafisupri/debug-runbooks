---
import "@fontsource-variable/ibm-plex-sans";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { jsonForScript } from "../lib/activity.ts";

interface Props {
  title?: string;
  description: string;
  /** "article" for runbooks; adds article Open Graph type. */
  type?: "website" | "article";
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const { title, description, type = "website", jsonLd, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — Debug Runbooks` : "Debug Runbooks — engineering incidents, documented";
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content="Debug Runbooks" />
    <meta property="og:title" content={title ?? "Debug Runbooks"} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    {jsonLd && <script type="application/ld+json" set:html={jsonForScript(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
