---
import Base from "../layouts/Base.astro";
import RunbookList from "../components/RunbookList.astro";
import SignalTrace from "../components/SignalTrace.astro";
import { getRunbooks } from "../lib/collection.ts";
import { PLATFORMS, REPO_URL } from "../lib/paths.ts";
import { loadActivity } from "../lib/activity.ts";

const activity = await loadActivity();
const runbooks = await getRunbooks();
const recent = runbooks.slice(0, 6);
const platforms = PLATFORMS.map((p) => ({ ...p, n: runbooks.filter((r) => r.data.platform === p.id).length })).filter((p) => p.n);

const loop = [
  ["Observe", "Symptoms, exact errors, environment and versions."],
  ["Hypothesize & test", "What was tried — including what did not work."],
  ["Isolate", "The root cause, separated from coincidences."],
  ["Remediate", "The fix and the commands that applied it."],
  ["Verify", "Evidence the system is actually in the intended state."],
  ["Document", "Rollback, cleanup, and the short path if it happens again."],
];
---

<Base description="Reproducible troubleshooting notes from real incidents with AI agent CLIs, model gateways, authentication and local services on macOS and Windows — each with root cause and verification.">
  <div class="wrap">
    <section class="intro" aria-labelledby="intro-title">
      <p class="label">Engineering field notebook</p>
      <h1 id="intro-title">Engineering incidents, documented.</h1>
      <p class="intro__lede">
        Debug Runbooks is a public log of {runbooks.length} real debugging sessions — AI agent CLIs, local model gateways and routers,
        OAuth and secret handling, launchd and PM2 services — each converted into a runbook that states what broke, why, what did not
        work, the fix, and how the fix was verified.
      </p>
      <p class="intro__platforms mono">
        {platforms.map((p, i) => <>{i > 0 && " · "}{p.label} {p.n}</>)}
      </p>
      <div class="intro__actions">
        <a class="button button--primary" href="/runbooks/">Browse runbooks</a>
        <a class="button ext" href={REPO_URL} rel="noopener">View repository</a>
      </div>
    </section>

    {activity && <SignalTrace activity={activity} />}

    <section class="recent" aria-labelledby="recent-title">
      <div class="section-head">
        <h2 id="recent-title">Recent incidents</h2>
        <a href="/runbooks/">All {runbooks.length} runbooks →</a>
      </div>
      <RunbookList runbooks={recent} />
    </section>

    <section class="method" aria-labelledby="method-title">
      <div class="section-head">
        <h2 id="method-title">How each runbook is structured</h2>
        <a href="/about/">Approach →</a>
      </div>
      <ol class="loop" role="list">
        {
          loop.map(([name, text], i) => (
            <li>
              <span class="loop__n mono">{String(i + 1).padStart(2, "0")}</span>
              <strong>{name}</strong>
              <span>{text}</span>
            </li>
          ))
        }
      </ol>
      <p class="method__note">
        AI tools assist the investigation; they are reviewers, not the source of truth. A runbook is considered done when the
        verification section shows the actual system state — not when a model agrees.
      </p>
    </section>
  </div>
</Base>

<style>
  .intro {
    display: grid;
    gap: var(--space-4);
    max-inline-size: 60rem;
    padding-block: var(--space-7) var(--space-7);
  }

  .intro .label {
    margin: 0;
  }

  h1 {
    margin: 0;
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
  }

  .intro__lede {
    margin: 0;
    max-inline-size: 62ch;
    font-size: var(--text-md);
    color: var(--text-secondary);
  }

  .intro__platforms {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .intro__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-2);
  }

  .recent,
  .method {
    margin-block-start: var(--space-8);
  }

  .section-head a {
    font-size: var(--text-sm);
  }

  .loop {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: var(--border-thin) solid var(--border-default);
  }

  .loop li {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
    border-block-end: var(--border-thin) solid var(--border-subtle);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .loop strong {
    color: var(--text-primary);
    font-size: var(--text-base);
  }

  .loop__n {
    font-size: var(--text-xs);
    color: var(--text-accent);
  }

  .method__note {
    max-inline-size: 70ch;
    margin: var(--space-5) 0 0;
    padding-inline-start: var(--space-4);
    border-inline-start: var(--border-thick) solid var(--border-accent);
    color: var(--text-secondary);
  }
</style>
