---
/** Dense runbook list (not cards). Each row is one incident. */
import PlatformMark from "./PlatformMark.astro";
import StatusMark from "./StatusMark.astro";
import { formatDate, type RunbookEntry } from "../lib/collection.ts";
import { termById } from "../lib/taxonomy.ts";

interface Props {
  runbooks: RunbookEntry[];
  /** Adds data attributes used by the /runbooks filter script. */
  filterable?: boolean;
  headingLevel?: "h2" | "h3";
  maxSystems?: number;
}
const { runbooks, filterable = false, headingLevel = "h3", maxSystems = 4 } = Astro.props;
const H = headingLevel;
---

<ol class="runbook-list" role="list">
  {
    runbooks.map(({ id, data }) => {
      const systems = data.systems.map((s) => termById(s)?.label ?? s);
      return (
        <li
          class="runbook-row"
          data-platform={filterable ? data.platform : undefined}
          data-status={filterable ? data.status : undefined}
          data-systems={filterable ? data.systems.join(" ") : undefined}
          data-date={filterable ? data.date.value : undefined}
          data-search={filterable ? `${data.title} ${data.summary ?? ""} ${systems.join(" ")} ${data.platformLabel}`.toLowerCase() : undefined}
        >
          <div class="runbook-row__meta">
            <time class="mono" datetime={data.date.value}>
              {formatDate(data.date.value)}
            </time>
            <PlatformMark platform={data.platform} label={data.platformLabel} />
            <StatusMark kind={data.status} />
          </div>
          <div class="runbook-row__body">
            <H class="runbook-row__title">
              <a href={`/runbooks/${id}/`}>{data.title}</a>
            </H>
            {data.summary && <p class="runbook-row__summary">{data.description}</p>}
            {systems.length > 0 && (
              <p class="runbook-row__systems">
                <span class="visually-hidden">Systems: </span>
                {systems.slice(0, maxSystems).join(" · ")}
                {systems.length > maxSystems && <span class="muted"> +{systems.length - maxSystems}</span>}
              </p>
            )}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .runbook-list {
    margin: 0;
    padding: 0;
    list-style: none;
    container-type: inline-size;
  }

  .runbook-row {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-block-end: var(--border-thin) solid var(--border-subtle);
  }

  .runbook-row[hidden] {
    display: none;
  }

  .runbook-row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-4);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .runbook-row__meta time {
    font-size: var(--text-xs);
    min-inline-size: 7.5em;
  }

  .runbook-row__title {
    margin: 0;
    font-size: var(--text-md);
    font-weight: 600;
    line-height: 1.3;
  }

  .runbook-row__title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .runbook-row__title a:hover {
    color: var(--text-link);
    text-decoration: underline;
  }

  .runbook-row__summary {
    margin: var(--space-1) 0 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    max-inline-size: 80ch;
  }

  .runbook-row__systems {
    margin: var(--space-2) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  @container (min-width: 46rem) {
    .runbook-row {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: var(--space-5);
    }

    .runbook-row__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
      padding-block-start: 0.2em;
    }
  }
</style>
