---
import Base from "../layouts/Base.astro";
import { getRunbooks } from "../lib/collection.ts";
import { REPO_URL } from "../lib/paths.ts";

const runbooks = await getRunbooks();
const withCredits = runbooks.filter((r) => r.data.provenance).length;
const withFailed = runbooks.filter((r) => r.data.phases.hypothesize.length).length;

/*
 * TODO(author): replace the three marked placeholders below with your own
 * facts (name, background, links). Nothing here is inferred about you.
 */
const AUTHOR = {
  name: "[Your name]",
  background: "[One or two factual sentences about your background and current focus.]",
  links: [{ label: "GitHub", href: "https://github.com/wafisupri" }],
};
---

<Base title="About" description="Why Debug Runbooks exists, how the incidents are investigated, and how AI-assisted tooling is used and checked.">
  <div class="wrap about">
    <header class="page-head">
      <h1>About</h1>
    </header>

    <section aria-labelledby="who">
      <h2 id="who">Who maintains this</h2>
      <p><strong data-placeholder>{AUTHOR.name}</strong> — <span data-placeholder>{AUTHOR.background}</span></p>
      <p>I am interested in AI platform engineering: the unglamorous layer where agents, model gateways, credentials and local services have to work together reliably.</p>
      <ul class="links" role="list">
        {AUTHOR.links.map((l) => <li><a class="ext" href={l.href} rel="noopener me">{l.label}</a></li>)}
      </ul>
    </section>

    <section aria-labelledby="why">
      <h2 id="why">Why the runbooks exist</h2>
      <p>
        Most of these problems were not hard because of a single bug; they were hard because several layers — a CLI, a gateway, a
        LaunchAgent, a credential store — failed at once and produced misleading symptoms. A runbook preserves the part that is
        expensive to rediscover: which signal was real, which fix was only cosmetic, and how to prove the system is healthy.
      </p>
      <p>
        {withFailed} of the {runbooks.length} runbooks keep a section on what did not work. Failed hypotheses stay in, because they are
        the fastest way to avoid repeating them.
      </p>
    </section>

    <section aria-labelledby="how">
      <h2 id="how">How I investigate</h2>
      <ol class="steps">
        <li><strong>Observe</strong> — capture the exact error, versions, ports, paths and what changed.</li>
        <li><strong>Hypothesize and test</strong> — one change at a time, recording what each test showed.</li>
        <li><strong>Isolate</strong> — separate the root cause from things that merely happened at the same time.</li>
        <li><strong>Remediate</strong> — prefer the supported fix over a patch that hides the symptom; keep a rollback.</li>
        <li><strong>Verify</strong> — check the real system state: service status, listening sockets, audit output, a live request.</li>
        <li><strong>Document</strong> — write the runbook, including the shortest path if it happens again.</li>
      </ol>
    </section>

    <section aria-labelledby="ai">
      <h2 id="ai">How I use AI tools</h2>
      <p class="pull">AI assists the engineer. Evidence establishes correctness.</p>
      <p>
        I use AI as a reviewer, not as the source of truth. Important changes are challenged through repeated CLI/IDE reviews,
        coding-agent review and an independent second opinion before being verified against the actual system.
      </p>
      <ol class="pipeline" role="list">
        <li>Implementation</li>
        <li>CLI/IDE review</li>
        <li>CLI/IDE review again</li>
        <li>Coding-agent review</li>
        <li>Independent second opinion</li>
        <li class="pipeline__evidence">Evidence-based verification</li>
      </ol>
      <p>
        Several agreeing models are still not proof. Confidence comes from builds, tests, command output, logs, configuration
        validation and observed runtime behaviour. {withCredits} runbooks name the AI tools involved in a credits or provenance
        section; the others simply do not record it, and the site does not guess.
      </p>
    </section>

    <section aria-labelledby="site">
      <h2 id="site">About this site</h2>
      <p>
        The site is generated at build time from the Markdown in <a class="ext" href={REPO_URL} rel="noopener">the repository</a>, which
        stays the source of truth. Dates, status and systems are read from each runbook and shown with their source; local home paths are
        redacted on the web pages; activity comes from git history. It was built with AI-assisted tooling and reviewed the same way as
        the runbooks.
      </p>
    </section>
  </div>
</Base>

<style>
  .about {
    max-inline-size: calc(var(--measure) + 2 * var(--gutter));
    margin-inline: 0 auto;
  }

  @media (min-width: 64rem) {
    .about {
      margin-inline: auto;
    }
  }

  .page-head {
    padding-block: var(--space-6) var(--space-3);
  }

  h1 {
    margin: 0;
    font-size: var(--text-xl);
  }

  section {
    padding-block: var(--space-4);
  }

  h2 {
    margin: 0 0 var(--space-3);
    padding-block-start: var(--space-3);
    border-block-start: var(--border-thin) solid var(--border-default);
    font-size: var(--text-md);
  }

  p,
  li {
    color: var(--text-secondary);
  }

  [data-placeholder] {
    outline: var(--border-thin) dashed var(--status-unstated);
    outline-offset: 2px;
  }

  .links {
    display: flex;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .steps li + li {
    margin-block-start: var(--space-2);
  }

  .steps strong {
    color: var(--text-primary);
  }

  .pull {
    margin-block: var(--space-2) var(--space-4);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text-primary);
  }

  .pipeline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .pipeline li {
    padding: var(--space-1) var(--space-2);
    border: var(--border-thin) solid var(--border-default);
    color: var(--text-secondary);
  }

  .pipeline li:not(:last-child)::after {
    content: " →";
    color: var(--text-muted);
  }

  .pipeline__evidence {
    border: var(--border-thick) solid var(--brand-primary) !important;
    color: var(--text-primary) !important;
    font-weight: 600;
  }
</style>
